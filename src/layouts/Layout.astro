---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  darkDemo?: boolean;
}

const {
  title = "Muhammad Shahzaib · Software Engineer, Robotics & Full-Stack",
  description = "From logic to motion. I build software for robots, and the resilient apps and web systems around them.",
  currentPath = Astro.url.pathname,
  darkDemo = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Muhammad Shahzaib" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/shahzaib-arbo.webp" />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />

    <!-- Hard Gate Accessibility: Pre-empt reduced motion in CSS -->
    <style is:inline>
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body class={darkDemo ? 'theme-dark' : ''}>
    <noscript>
      <div class="no-js-warning font-mono" role="status">
        <strong>Notice:</strong> JavaScript is disabled. All narrative chapters, case studies, architecture diagrams, and contact routing remain fully readable and accessible.
      </div>
    </noscript>

    <Nav currentPath={currentPath} />

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .site-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
