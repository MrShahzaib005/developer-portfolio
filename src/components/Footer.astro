<style>
  .site-footer {
    background-color: var(--bg-subtle);
    border-top: 1px solid var(--border-light);
    padding: 4.5rem 0 2.5rem;
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 860px) {
    .footer-top {
      grid-template-columns: 4fr 7fr;
      gap: 4rem;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }

  .brand-point {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-orange);
  }

  .brand-name {
    font-size: 1.125rem;
  }

  .footer-tagline {
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 380px;
    margin-bottom: 1.25rem;
  }

  .audit-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-faint);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10B981;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 2rem;
  }

  .col-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-col a {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .footer-col a:hover {
    color: var(--accent-orange);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .location-availability {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .avail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-orange);
    box-shadow: 0 0 6px var(--accent-orange-glow);
  }

  .avail-text {
    color: var(--text-main);
    font-weight: 500;
  }
</style>
