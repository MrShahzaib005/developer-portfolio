---
const experiences = [
  {
    role: "Website Project",
    company: "Arbotrix",
    period: "Project",
    type: "Company Website",
    bullets: [
      "Built the website for Arbotrix, a robotics company."
    ]
  },
  {
    role: "Lead Backend & Agentic AI Architect (FYP)",
    company: "Buddy: Multi-Tenant Agentic AI",
    period: "2026 — Present",
    type: "Systems / Machine Learning",
    bullets: [
      "Engineered a Java 23 & Spring Boot 3.x multi-agent orchestration architecture using LangChain4j and local Ollama (Llama 3.1 8B) edge inference.",
      "Implemented ThreadLocal tenant isolation and pgvector cosine-distance filters, guaranteeing zero cross-tenant retrieval leaks across 1,000 synthetic benchmark queries.",
      "Designed prompt-level tool schema sandboxing to eliminate hallucinations and unapproved tool invocations on small 8B language models."
    ]
  },
  {
    role: "Bachelor of Science in Computer Science (BSCS)",
    company: "Iqra University",
    period: "Expected 2026",
    type: "Academic Foundation",
    bullets: [
      "Rigorous core curriculum in Operating Systems, Concurrent Programming, Relational Databases, and Cyber-Physical Systems.",
      "Formative capstone projects including the Java Spring Boot university academic portal (e-portal) and autonomous robotics simulation testbenches."
    ]
  }
];
---

<section class="experience-timeline-section" aria-label="Experience & Selected Projects">
  <div class="container">
    <div class="timeline-header">
      <span class="chapter-num">06 / Experience & Projects</span>
      <h2>Professional Experience & Selected Projects</h2>
      <p class="narrative-lead" style="max-width: 680px; margin-top: 0.5rem;">
        Building practical software across web applications, robotics, and AI systems.
      </p>
    </div>

    <div class="timeline-list">
      {experiences.map((item, idx) => (
        <article class="timeline-item surface-card">
          <div class="item-header-row">
            <div>
              <div class="item-badge-row">
                <span class="mono-tag active">{item.type}</span>
                <span class="item-period font-mono">{item.period}</span>
              </div>
              <h3 class="item-title">{item.role}</h3>
              <div class="item-company font-mono">{item.company}</div>
            </div>
          </div>

          <ul class="item-bullets">
            {item.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="timeline-footer font-mono">
      <span>Looking for full CV details, coursework, and physical hardware lab inventory?</span>
      <a href="/about#resume" class="link-inline">
        Explore Complete About & CV Page →
      </a>
    </div>
  </div>
</section>

<style>
  .experience-timeline-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .timeline-header {
    margin-bottom: 2.75rem;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timeline-item {
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border-left: 3px solid var(--accent-orange);
  }

  .item-header-row {
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-faint);
    padding-bottom: 1rem;
  }

  .item-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .item-period {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .item-title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.3;
    color: var(--text-main);
  }

  .item-company {
    font-size: 0.8125rem;
    color: var(--accent-orange);
    font-weight: 600;
    margin-top: 0.25rem;
  }

  .item-bullets {
    list-style: square;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .timeline-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    margin-top: 2rem;
    font-size: 0.8125rem;
    color: var(--text-faint);
    padding: 1rem 1.25rem;
    background-color: var(--bg-primary);
    border-radius: 6px;
    border: 1px solid var(--border-faint);
  }

  @media (min-width: 640px) {
    .timeline-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
