<section class="recruiter-dossier-section" aria-label="Executive Recruiter Brief">
  <div class="container">
    <div class="dossier-card surface-card">
      <div class="dossier-header">
        <div class="dossier-badge-row">
          <span class="dossier-badge font-mono">Fast-Track Brief</span>
          <span class="dossier-read-time font-mono">⏱️ 30-Second Recruiter Summary</span>
        </div>
        <h2 class="dossier-title">Executive Engineering Dossier</h2>
        <p class="dossier-subtitle">
          Key qualifications, leadership scope, core competencies, and immediate availability for technical hiring teams.
        </p>
      </div>

      <div class="dossier-grid">
        <div class="dossier-item font-mono">
          <span class="item-label">Selected Project</span>
          <h4 class="item-val-title">Arbotrix Company Website</h4>
          <p class="item-desc">
            Built the website for Arbotrix, a robotics company.
          </p>
        </div>

        <div class="dossier-item font-mono">
          <span class="item-label">Target Roles</span>
          <h4 class="item-val-title">Robotics / Full-Stack Engineer</h4>
          <p class="item-desc">
            Targeting full-time roles across <strong>Robotics Software</strong> (ROS 2/Nav2/Jetson), <strong>Full-Stack Web</strong> (Next.js/React/Spring Boot), or <strong>Agentic AI Backend Systems</strong>.
          </p>
        </div>

        <div class="dossier-item font-mono">
          <span class="item-label">Education & Foundation</span>
          <h4 class="item-val-title">BS Computer Science · Iqra University</h4>
          <p class="item-desc">
            Expected 2026. Deep coursework and practical projects in Operating Systems, Concurrency, Distributed Databases, and Cyber-Physical Systems.
          </p>
        </div>

        <div class="dossier-item font-mono">
          <span class="item-label">Logistics & Availability</span>
          <h4 class="item-val-title" style="color: #10B981;">Immediate / 2026–2027 Roles</h4>
          <p class="item-desc">
            Based in Islamabad, Pakistan (UTC+5). Fully equipped for remote global engineering teams (US, UK, EU, APAC overlap) with zero notice period.
          </p>
        </div>
      </div>

      <div class="dossier-actions-bar">
        <div class="actions-left">
          <a href="/about#resume" class="btn btn-primary font-mono btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>View & Download Résumé (PDF)</span>
          </a>

          <a 
            href="mailto:mirzashahzaibsami123456789@gmail.com?subject=Engineering%20Opportunity%20-%20Muhammad%20Shahzaib&body=Hi%20Shahzaib%2C%0A%0AWe%20reviewed%20your%20portfolio%20and%20would%20like%20to%20discuss%20an%20engineering%20opportunity..." 
            class="btn btn-secondary font-mono btn-sm"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>Direct Email Fast-Track</span>
          </a>
        </div>

        <div class="actions-right font-mono">
          <a href="https://www.linkedin.com/in/mr-shahzaib" target="_blank" rel="noopener noreferrer" class="link-inline">
            <span>LinkedIn Profile ↗</span>
          </a>
          <span class="sep-dot" aria-hidden="true">·</span>
          <a href="https://github.com/MrShahzaib005" target="_blank" rel="noopener noreferrer" class="link-inline">
            <span>GitHub Repositories ↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .recruiter-dossier-section {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .dossier-card {
    background: rgba(20, 14, 38, 0.85);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 16px;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(14px);
  }

  .dossier-header {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 1.25rem;
  }

  .dossier-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .dossier-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #D8B4FE;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: rgba(168, 85, 247, 0.15);
    border: 1px solid var(--accent-purple);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .dossier-read-time {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .dossier-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    margin-bottom: 0.35rem;
    color: var(--text-main);
  }

  .dossier-subtitle {
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 720px;
  }

  .dossier-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 640px) {
    .dossier-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .dossier-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .dossier-item {
    background-color: rgba(11, 8, 19, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .item-label {
    font-size: 0.6875rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .item-val-title {
    font-size: 0.9375rem;
    color: var(--text-main);
    line-height: 1.35;
    font-family: var(--font-sans);
  }

  .item-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.5;
    font-family: var(--font-sans);
    margin-top: 0.25rem;
  }

  .dossier-actions-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-light);
  }

  @media (min-width: 768px) {
    .dossier-actions-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .actions-left {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .actions-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
  }

  .sep-dot {
    color: var(--border-strong);
  }
</style>
