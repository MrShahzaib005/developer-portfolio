---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/#experience', label: 'Experience' },
  { href: '/lab', label: '3D & Lab' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="Muhammad Shahzaib homepage">
      <span class="brand-point" aria-hidden="true"></span>
      <span class="brand-name">Muhammad Shahzaib</span>
    </a>

    <nav class="main-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li>
              <a 
                href={link.href} 
                class={`nav-link ${isActive ? 'is-active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <a 
        href="/Shahzaib_Resume.pdf" 
        download="Shahzaib_Resume.pdf"
        class="resume-pill font-mono"
        title="Download Résumé (PDF)"
      >
        <span>CV / Résumé</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(11, 8, 19, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: 68px;
    display: flex;
    align-items: center;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .brand-point {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-gradient);
    box-shadow: 0 0 12px rgba(217, 70, 239, 0.8);
    display: inline-block;
  }

  .brand-name {
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    font-weight: 700;
  }

  .main-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.35rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    position: relative;
    min-height: 40px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .nav-link.is-active {
    color: #FFFFFF;
    font-weight: 600;
    background-color: rgba(168, 85, 247, 0.15);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    right: 0.9rem;
    bottom: 0.25rem;
    left: 0.9rem;
    height: 2px;
    background: var(--accent-gradient);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
  }

  .resume-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    background: var(--accent-gradient);
    border: none;
    color: #FFFFFF;
    box-shadow: 0 2px 14px rgba(168, 85, 247, 0.35);
    transition: all var(--transition-fast);
  }

  .resume-pill:hover {
    box-shadow: 0 4px 20px rgba(217, 70, 239, 0.6);
    transform: translateY(-1px);
    color: #FFFFFF;
  }
</style>
