---
import Layout from '../../layouts/Layout.astro';
import FilterableWork from '../../components/FilterableWork';
import { PROJECTS } from '../../data/projects';
---

<Layout
  title="Projects & Case Studies · Muhammad Shahzaib"
  description="Catalog of projects and case studies across Robotics, Full-Stack Web, Agentic AI, and Embedded Systems."
>
  <div class="work-page section-spacing">
    <div class="container">
      <header class="work-page-header text-center">
        <span class="chapter-num font-mono">Portfolio</span>
        <h1>Projects & Case Studies</h1>
        <p class="narrative-lead" style="max-width: 720px; margin: 0.75rem auto 0;">
          Production platforms, cyber-physical robotics, and autonomous systems with verified open-source repositories and architectural breakdowns.
        </p>
      </header>

      {/* Simplified React Island for dynamic client-side filtering by professional field */}
      <FilterableWork client:load projects={PROJECTS} />

      {/* Hard Gate Accessibility: Static HTML fallback if JS is disabled */}
      <noscript>
        <div class="static-no-js-list">
          <h2 style="margin: 2rem 0 1rem;">Complete Project Catalog (Static HTML)</h2>
          <div class="asym-grid asym-grid-half">
            {PROJECTS.map(p => (
              <div class="surface-card">
                <span class="mono-tag">{p.domain}</span>
                <h3 style="margin: 0.5rem 0;"><a href={`/work/${p.slug}`}>{p.title}</a></h3>
                <p>{p.subtitle}</p>
                <p style="font-size: 0.8125rem; margin-top: 0.5rem; color: var(--text-faint);"><strong>Ownership:</strong> {p.ownershipStatement}</p>
                <a href={`/work/${p.slug}`} class="link-inline font-mono" style="margin-top: 0.75rem; display: inline-block;">View Case Study →</a>
              </div>
            ))}
          </div>
        </div>
      </noscript>
    </div>
  </div>
</Layout>

<style>
  .work-page-header {
    margin-bottom: 3rem;
  }

  .static-no-js-list {
    margin-top: 2rem;
  }
</style>
