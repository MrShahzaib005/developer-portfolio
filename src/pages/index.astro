---
import Layout from '../layouts/Layout.astro';
import Robot3DScene from '../components/Robot3DScene';
import InteractiveSkills from '../components/InteractiveSkills';
import RecruiterDossier from '../components/RecruiterDossier.astro';
import FilterableWork from '../components/FilterableWork';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { PROJECTS } from '../data/projects';
---

<Layout
  title="Muhammad Shahzaib · Full-Stack & Robotics Software Engineer"
  description="Portfolio of Muhammad Shahzaib: Full-Stack Web & Robotics Software Engineer. Built the website for Arbotrix, ROS 2 teleoperation systems, and Next.js applications."
>
  {/* ================= 01 / HERO SECTION (FIGMA STYLE) ================= */}
  <section class="figma-hero-section section-spacing" aria-label="Hero Introduction">
    <div class="ambient-glow-orb hero-glow-purple"></div>
    <div class="ambient-glow-orb hero-glow-cyan"></div>

    <div class="container">
      <div class="hero-grid">
        {/* Left: Introduction & CTAs */}
        <div class="hero-content">
          <div class="hero-badge font-mono">
            <span class="badge-dot" aria-hidden="true"></span>
            <span>Available for Full-Time & Contract Roles</span>
          </div>

          <h1 class="hero-headline">
            Hi, I'm <span class="gradient-text">Muhammad Shahzaib</span>
          </h1>

          <h2 class="hero-subtitle">
            Full-Stack Web & Robotics Software Engineer
          </h2>

          <p class="hero-description">
            I build high-performance web platforms and software for autonomous robots. Built the official company website for <strong>Arbotrix</strong>, real-time ROS 2 robot teleoperation on Jetson hardware, and resilient full-stack systems.
          </p>

          <div class="hero-actions">
            <a href="#contact" class="btn btn-primary">
              <span>Get in touch</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="/Shahzaib_Resume.pdf" download="Shahzaib_Resume.pdf" class="btn btn-secondary font-mono" title="Download CV (PDF)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download CV</span>
            </a>
            <a href="#projects" class="btn btn-secondary font-mono">
              <span>View Projects ↓</span>
            </a>
          </div>

          {/* Social Links Row */}
          <div class="hero-socials font-mono">
            <a href="https://github.com/MrShahzaib005" target="_blank" rel="noopener noreferrer" class="social-icon-link" title="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              <span>GitHub</span>
            </a>

            <a href="https://www.linkedin.com/in/mr-shahzaib" target="_blank" rel="noopener noreferrer" class="social-icon-link" title="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              <span>LinkedIn</span>
            </a>

            <a href="mailto:mr.shahzaib25005@gmail.com" class="social-icon-link" title="Email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>Email</span>
            </a>
          </div>
        </div>

        {/* Right: Glowing Portrait Frame */}
        <div class="hero-visual">
          <div class="avatar-glow-ring">
            <div class="avatar-inner-frame">
              <img
                src="/images/shahzaib-arbo.webp"
                alt="Muhammad Shahzaib"
                class="avatar-image"
                loading="eager"
              />
              <div class="avatar-status-tag font-mono">
                <span class="status-live-dot"></span>
                <span>Open for Global Roles</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ================= 02 / ABOUT SECTION (CENTERED FIGMA STYLE) ================= */}
  <section class="about-summary-section" id="about" aria-label="About Summary">
    <div class="container container-narrow text-center">
      <span class="chapter-num font-mono">About</span>
      <h2 class="section-title">Bridging Code to Cyber-Physical Motion</h2>
      
      <p class="about-lead">
        I'm a Software Engineer based in Islamabad, Pakistan, specializing in the intersection of <strong>high-performance web architecture</strong> and <strong>embedded robotics systems</strong>.
      </p>

      <p class="about-subtext">
        I engineered the production website for Arbotrix, a robotics company, managing applicant pipelines for 45 verified graduates. In cyber-physical robotics, I build ROS 2 Humble telemetry stacks on NVIDIA Jetson Linux single-board computers, connecting hardware to intuitive Flutter and Next.js interfaces with under 45ms WebSocket latency.
      </p>

      {/* Quick 3 Stats Counters */}
      <div class="stats-counter-grid font-mono">
        <div class="stat-card">
          <span class="stat-number gradient-text">3+</span>
          <span class="stat-label">Flagship Systems Built</span>
        </div>
        <div class="stat-card">
          <span class="stat-number gradient-text">45+</span>
          <span class="stat-label">Graduates via Arbotrix</span>
        </div>
        <div class="stat-card">
          <span class="stat-number gradient-text">&lt;45ms</span>
          <span class="stat-label">WebSocket Telemetry</span>
        </div>
        <div class="stat-card">
          <span class="stat-number gradient-text">2026</span>
          <span class="stat-label">BS CS · Iqra University</span>
        </div>
      </div>
    </div>
  </section>

  {/* ================= 03 / 3D INTERACTIVE CENTERPIECE ================= */}
  <section class="center-3d-section" aria-label="3D Interactive Experience">
    <div class="container">
      <div class="text-center" style="margin-bottom: 2rem;">
        <span class="chapter-num font-mono">3D Interactive Robot</span>
        <h2>Explore Cyber-Physical Subsystems</h2>
        <p class="narrative-lead" style="max-width: 620px; margin: 0.5rem auto 0;">
          Drag to orbit 360°, inspect LiDAR laser scanning, and toggle CAD wireframe mode.
        </p>
      </div>

      <div class="robot-3d-container">
        <Robot3DScene client:visible />
      </div>
    </div>
  </section>

  {/* ================= 04 / FEATURED PROJECTS & CASE STUDIES (WITH FILTER BAR) ================= */}
  <section class="projects-section section-spacing" id="projects" aria-label="Featured Projects & Case Studies">
    <div class="container">
      <div class="text-center" style="margin-bottom: 2.5rem;">
        <span class="chapter-num font-mono">Portfolio</span>
        <h2>Engineering Work & Case Studies</h2>
        <p class="narrative-lead" style="max-width: 680px; margin: 0.5rem auto 0;">
          Filterable catalog of production platforms, cyber-physical robotics, and autonomous systems with verified public repositories.
        </p>
      </div>

      <FilterableWork client:load projects={PROJECTS} limit={4} showViewMore={true} />
    </div>
  </section>

  {/* ================= 05 / INTERACTIVE SKILLS SECTION ================= */}
  <section class="skills-interactive-section section-spacing" id="skills" aria-label="Skills & Tooling">
    <div class="container">
      <div class="text-center" style="margin-bottom: 3rem;">
        <span class="chapter-num font-mono">Skill Sets</span>
        <h2>Engineering Stack & Tooling</h2>
        <p class="narrative-lead" style="max-width: 650px; margin: 0.5rem auto 0;">
          Filterable matrix with proficiency levels and real-world project verification.
        </p>
      </div>

      <InteractiveSkills client:visible />
    </div>
  </section>

  {/* ================= 06 / EXPERIENCE TIMELINE ================= */}
  <ExperienceTimeline />

  {/* ================= 07 / RECRUITER 30-SEC BRIEF ================= */}
  <section class="section-spacing" id="recruiter-brief">
    <RecruiterDossier />
  </section>

  {/* ================= 07 / CONTACT SECTION (FIGMA STYLE) ================= */}
  <section class="contact-figma-section section-spacing" id="contact" aria-label="Contact Muhammad Shahzaib">
    <div class="container">
      <div class="contact-grid">
        {/* Left: Direct info */}
        <div class="contact-info-col">
          <span class="chapter-num font-mono">Contact</span>
          <h2 class="contact-title">Drop me a message</h2>
          <p class="contact-lead">
            I'm currently available for full-time roles, contract opportunities, and robotics collaborations. Let's build something exceptional together.
          </p>

          <div class="contact-details-list font-mono">
            <div class="c-detail-item">
              <span class="c-label">Direct Email</span>
              <a href="mailto:mr.shahzaib25005@gmail.com" class="c-val-link">
                mr.shahzaib25005@gmail.com
              </a>
            </div>

            <div class="c-detail-item">
              <span class="c-label">Location</span>
              <span class="c-val">Islamabad, PK (Global Remote Ready)</span>
            </div>

            <div class="c-detail-item">
              <span class="c-label">Availability</span>
              <span class="c-val" style="color: #10B981;">● Immediate (0 Notice Period)</span>
            </div>
          </div>

          <div class="contact-social-pills font-mono">
            <a href="https://www.linkedin.com/in/mr-shahzaib" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
              <span>LinkedIn Profile ↗</span>
            </a>
            <a href="https://github.com/MrShahzaib005" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
              <span>GitHub Repositories ↗</span>
            </a>
          </div>
        </div>

        {/* Right: Glassmorphic Message Box */}
        <div class="contact-form-col">
          <form 
            action="mailto:mr.shahzaib25005@gmail.com" 
            method="GET" 
            class="glassmorphism-form surface-card"
          >
            <h3 style="font-size: 1.25rem; margin-bottom: 1.25rem; color: #FFFFFF;">
              Send an inquiry
            </h3>

            <div class="form-group">
              <label for="name" class="font-mono form-label">Your Name</label>
              <input type="text" id="name" name="subject" placeholder="Recruiter / Founder Name" required />
            </div>

            <div class="form-group">
              <label for="email" class="font-mono form-label">Your Email</label>
              <input type="email" id="email" placeholder="name@company.com" required />
            </div>

            <div class="form-group">
              <label for="message" class="font-mono form-label">Message</label>
              <textarea id="message" name="body" rows="4" placeholder="Tell me about the engineering role, platform, or project scope..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
              <span>Send Message</span>
              <span aria-hidden="true">→</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  .figma-hero-section {
    position: relative;
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
  }

  .hero-glow-purple {
    top: -150px;
    right: 5%;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, transparent 65%);
  }

  .hero-glow-cyan {
    bottom: -100px;
    left: 5%;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, transparent 65%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 6.5fr 5.5fr;
      gap: 4rem;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #D8B4FE;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.3);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.2rem);
    line-height: 1.1;
    margin-bottom: 1rem;
    color: #FFFFFF;
    font-weight: 800;
  }

  .hero-subtitle {
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .hero-description {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .hero-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .social-icon-link:hover {
    color: var(--accent-magenta);
  }

  /* Avatar Frame */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .avatar-glow-ring {
    position: relative;
    padding: 8px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(217, 70, 239, 0.7) 0%, rgba(139, 92, 246, 0.5) 50%, rgba(6, 182, 212, 0.7) 100%);
    box-shadow: 0 10px 50px rgba(168, 85, 247, 0.35);
    max-width: 360px;
    width: 100%;
  }

  .avatar-inner-frame {
    position: relative;
    background: #0B0813;
    border-radius: 22px;
    overflow: hidden;
  }

  .avatar-image {
    width: 100%;
    height: 380px;
    object-fit: cover;
    object-position: center 15%;
    display: block;
    transition: transform 0.4s ease;
  }

  .avatar-inner-frame:hover .avatar-image {
    transform: scale(1.03);
  }

  .avatar-status-tag {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(11, 8, 19, 0.88);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #FFFFFF;
    justify-content: center;
  }

  .status-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  /* About Summary Section */
  .about-summary-section {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(20, 14, 38, 0.4);
  }

  .text-center {
    text-align: center;
  }

  .section-title {
    font-size: clamp(1.85rem, 3.5vw, 2.6rem);
    margin: 0.5rem 0 1.25rem;
    color: #FFFFFF;
  }

  .about-lead {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: #FFFFFF;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .about-subtext {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .stats-counter-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 680px) {
    .stats-counter-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    background: rgba(20, 14, 38, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 800;
  }

  .stat-label {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  /* 3D Centerpiece */
  .center-3d-section {
    padding: clamp(3.5rem, 6vw, 5rem) 0;
  }

  .robot-3d-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Zig-Zag Projects */
  .projects-zigzag-list {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .project-zigzag-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 880px) {
    .project-zigzag-item {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }

    .project-zigzag-item.reverse .project-info {
      order: 2;
    }

    .project-zigzag-item.reverse .project-preview-wrap {
      order: 1;
    }
  }

  .project-tag {
    font-size: 0.6875rem;
    color: var(--accent-magenta);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .project-heading {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    color: #FFFFFF;
    margin-bottom: 0.85rem;
    line-height: 1.25;
  }

  .project-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .ownership-chip {
    background: rgba(20, 14, 38, 0.8);
    border-left: 3px solid var(--accent-purple);
    padding: 0.5rem 0.75rem;
    border-radius: 0 6px 6px 0;
    font-size: 0.75rem;
    color: #D8B4FE;
    margin-bottom: 1.25rem;
    line-height: 1.45;
  }

  .tech-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .tech-pills-row span {
    font-size: 0.6875rem;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #E2E8F0;
  }

  .project-actions {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 0.45rem 1rem;
    font-size: 0.8125rem;
  }

  .project-preview-wrap {
    background: #140E26;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
  }

  .preview-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-preview-img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 340px;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s ease;
  }

  .project-preview-wrap:hover .project-preview-img {
    transform: scale(1.03);
  }

  /* Skills Interactive */
  .skills-interactive-section {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(20, 14, 38, 0.3);
  }

  /* Contact Section */
  .contact-figma-section {
    position: relative;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 4rem;
    }
  }

  .contact-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: #FFFFFF;
    margin: 0.5rem 0 1rem;
  }

  .contact-lead {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-details-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .c-detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .c-label {
    font-size: 0.6875rem;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .c-val-link {
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .c-val-link:hover {
    color: var(--accent-magenta);
  }

  .c-val {
    color: #FFFFFF;
    font-size: 0.9375rem;
  }

  .contact-social-pills {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .glassmorphism-form {
    background: rgba(20, 14, 38, 0.85);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(16px);
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }
</style>
