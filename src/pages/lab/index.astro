---
import Layout from '../../layouts/Layout.astro';
import LabPlayground from '../../components/LabPlayground';
import RosTopicBusSimulator from '../../components/RosTopicBusSimulator';

const archivedPlaygrounds = [
  {
    title: "GamesVerse Esports Platform",
    category: "Web & Gaming Portal",
    stack: "PHP · MySQL · React",
    description: "Official university esports platform hosted on gamesverse.net for Valorant and Tekken tournaments with automated brackets and roster registrations.",
    repoUrl: "https://github.com/MrShahzaib005/Gameverse",
    demoUrl: "https://gamesverse.net/"
  },
  {
    title: "Foodly Food Ordering Interface",
    category: "Interactive Web UI",
    stack: "React · JavaScript · CSS",
    description: "Mobile-first food delivery frontend exploring client-side cart synchronization, localStorage persistence, and dietary category filtering.",
    repoUrl: "https://github.com/MrShahzaib005/foodly"
  },
  {
    title: "React E-Commerce Shop",
    category: "Frontend Showcase",
    stack: "React · JavaScript · CSS",
    description: "Modern storefront UI featuring product catalog filters, flyout cart drawer badge animations, and computed item subtotal state management.",
    repoUrl: "https://github.com/MrShahzaib005/reactjs-ecommerce-shop"
  },
  {
    title: "Iqra Student Portal App",
    category: "Mobile Companion",
    stack: "Flutter · Dart · Firebase",
    description: "Cross-platform student companion app providing mobile access to fee vouchers, timetable schedules, and GPA projections with offline SQLite caching.",
    repoUrl: "https://github.com/MrShahzaib005/iqra_student_portal"
  },
  {
    title: "Bevensen Restaurant Website",
    category: "Design to Code",
    stack: "TypeScript · HTML5 · CSS3",
    description: "Restaurant menu presentation site in TypeScript. Fixed Figma export title to production branding with categorized meal tabs and responsive photography.",
    repoUrl: "https://github.com/MrShahzaib005/bevensen-website"
  },
  {
    title: "Dynamics 360 Event Explorer",
    category: "Single Page Application",
    stack: "Vanilla JS · Async REST · CSS",
    description: "Zero-dependency single-page application with asynchronous JSON parsing, real-time debounced filtering, and accessible modal navigation.",
    repoUrl: "https://github.com/MrShahzaib005/dynamics360-featured-events"
  },
  {
    title: "Code Flow Design System",
    category: "Typography Sandbox",
    stack: "Tailwind CSS · JavaScript",
    description: "Experimental layout engine exploring asymmetric editorial column flow, elevation hover effects, and WCAG AA accessibility token contrasts.",
    repoUrl: "https://github.com/MrShahzaib005/code-flow"
  },
  {
    title: "University Database Relational Schema",
    category: "Data Architecture",
    stack: "SQL · PostgreSQL / MySQL",
    description: "Relational data modeling exercise enforcing 3rd normal form (3NF) with composite indexes for student registration and transcript calculations.",
    repoUrl: "https://github.com/MrShahzaib005/university-db"
  }
];
---

<Layout
  title="The Lab · Interactive Robotics & Systems Experiments"
  description="Playful and experimental projects: 2D kinematics simulation, PID tuning, ROS 2 pub/sub message bus, and software playgrounds."
>
  <div class="lab-page section-spacing">
    <div class="container">
      <header class="lab-header">
        <span class="chapter-num">/lab · Playground & Experiments</span>
        <h1>Interactive Systems Lab</h1>
        <p class="narrative-lead" style="max-width: 720px; margin-top: 0.75rem;">
          Engineering ideas made tangible. A sandbox for differential kinematics, control theory gains, ROS 2 middleware message routing, and front-end software experiments.
        </p>
      </header>

      {/* Main Interactive Experiment 01: 2D Differential Drive & PID */}
      <div style="margin-bottom: 4.5rem;">
        <LabPlayground client:load />
      </div>

      {/* Second Interactive Experiment 02: ROS 2 Topic & Pub/Sub Visualizer */}
      <div style="margin-bottom: 5rem;">
        <RosTopicBusSimulator client:visible />
      </div>

      {/* Experimental Archives: 8 Audited Projects Grid */}
      <section class="archived-playgrounds-section">
        <div class="archive-header">
          <div>
            <span class="chapter-num">Archived Playgrounds</span>
            <h2>Audited Repositories & Playgrounds</h2>
          </div>
          <p class="archive-subtext">
            Foundational web platforms, mobile client prototypes, design systems, and data schemas built across university coursework and open-source explorations.
          </p>
        </div>

        <div class="playgrounds-grid">
          {archivedPlaygrounds.map((item) => (
            <article class="playground-card surface-card">
              <div class="card-meta-top">
                <span class="mono-tag">{item.category}</span>
                <span class="stack-badge font-mono">{item.stack}</span>
              </div>

              <h3 class="item-title">{item.title}</h3>
              <p class="item-desc">{item.description}</p>

              <div class="card-links-row font-mono">
                <a href={item.repoUrl} target="_blank" rel="noopener noreferrer" class="link-inline">
                  <span>Source Code</span>
                  <span aria-hidden="true">→</span>
                </a>
                {item.demoUrl && (
                  <a href={item.demoUrl} target="_blank" rel="noopener noreferrer" class="live-pill" title="Open live production website">
                    <span>Live Demo ↗</span>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .lab-header {
    margin-bottom: 2.5rem;
  }

  .archive-header {
    margin-bottom: 2.25rem;
  }

  .archive-subtext {
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 680px;
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  .playgrounds-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .playgrounds-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .playgrounds-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }

  .playground-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .playground-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .card-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .stack-badge {
    font-size: 0.6875rem;
    color: var(--text-faint);
  }

  .item-title {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .item-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .card-links-row {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-faint);
  }

  .live-pill {
    color: var(--accent-orange);
    font-weight: 600;
  }

  .live-pill:hover {
    text-decoration: underline;
  }
</style>
